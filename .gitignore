# Node.js / Next.js
node_modules/
.next/
dist/
npm-debug.log*
*.tsbuildinfo

# Secrets. Next only ignores .env*.local by default, on the convention that a
# plain .env holds shared non-secret defaults. Ignoring both, so there is no
# way to commit a key by putting it in the wrong file.
.env
.env*.local

# Artwork. No images are committed to this repo.
#
# Hand-drawn avatar layers go here. Next only serves static files from public/,
# so the folder has to live inside it to be fetchable at runtime — but it stays
# gitignored, so real art can be dropped in locally without landing in a
# commit. CatAvatar falls back to its code-drawn placeholder when a layer is
# missing, which is the normal state for a fresh clone.
#
# Ignoring the *contents* rather than the folder itself. Git won't descend into
# an excluded directory, so `public/art-assets/` would make the negation below
# impossible and the README couldn't be tracked.
public/art-assets/*
!public/art-assets/README.md

# No image files of any kind.
# Note: git keeps tracking files committed before this rule was added (the
# brand logos, the docs/design mockups), so those are unaffected. New images
# need an explicit `git add -f` to get in, which is the point.
*.png
*.jpg
*.jpeg
*.gif
*.webp

# The one exception to the no-images rule: the pet photos on the About page.
# They are real content rather than artwork, they have to ship with the site to
# render on it, and the blanket rule above still covers everything else. Their
# metadata is stripped before they are added — see the note in app/about/page.tsx.
!public/images/pets/*.jpg
!public/images/pets/*.jpeg
!public/images/pets/*.png
!public/images/pets/*.webp

# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout

## compatibility with Xcode 3 and earlier (ignoring not required starting Xcode 4)
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# Accio dependency management
Dependencies/
.accio/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
#
# After new code Injection tools there's a generated folder /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/

# Local Claude notes — kept out of the repo.
.claude/commit-style.md
.claude/settings.local.json

# Vercel
.vercel

# The avatar artwork is the exception to the no-images rule above, and has to
# sit *after* it: gitignore takes the last matching rule, so a negation placed
# before `*.png` would be overridden by it.
#
# This art has to ship with the site to render on it — ignored art means every
# deployed cat falls back to the placeholder — and unlike generated filler it is
# real hand-drawn work. One file per face/hair/eye combination, plus its
# untinted features layer.
!public/art-assets/base-*.png
!public/art-assets/features-*.png
!public/art-assets/pattern-*.png

# The home page cat tree, same exception and for the same reason as the avatar
# artwork above — and it has to sit after `*.png` for the same ordering reason.
#
# This one is Heidi's line drawing with its enclosed regions flood-filled in
# brand colours; her linework is untouched, pixel for pixel. It cannot be drawn
# in code without redrawing it by hand, which loses the drawing, so it ships as
# a file. Without this it is ignored, and a fresh clone renders a broken image
# where the site's main navigation should be.
!public/images/cat-tree.png
